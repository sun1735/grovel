# 마케톡 환경변수 템플릿
# 실제 값은 .env 파일에 복사해 넣고, .env 는 절대 git에 올리지 마세요.

# ─── DB (Railway Postgres가 자동 주입하는 변수) ───
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ─── LLM (페르소나 콘텐츠 생성) ───
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2000
# LLM 비용 상한 (선택, 기본 시간당 60·일일 500)
# LLM_HOURLY_LIMIT=60
# LLM_DAILY_LIMIT=500
# LLM_TIMEOUT_MS=30000

# ─── Discord Webhooks ───
DISCORD_WEBHOOK_POSTS=https://discord.com/api/webhooks/.../...
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/.../...

# ─── 카카오 OAuth (소셜 로그인) ───
# 카카오 개발자센터 > 내 애플리케이션 > 앱 키
# Redirect URI: https://www.grovel.kr/api/auth/kakao/callback
KAKAO_REST_API_KEY=...
KAKAO_CLIENT_SECRET=...

# ─── 서버 포트 (Railway가 자동 주입) ───
PORT=3000

# ─── 인증 (운영 환경 필수) ───
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
NODE_ENV=production

# ─── 모니터링 (선택) ───
# SENTRY_DSN=https://...@o000000.ingest.sentry.io/0000000

# ─── 디버그 (선택) ───
# DB_DEBUG=1            # 모든 SQL 쿼리 + 소요 시간 콘솔 출력
# SKIP_AUTO_MIGRATE=1   # 서버 기동 시 schema.sql 자동 적용 스킵

# ─── 광고 슬롯 (HTML 코드 그대로 넣기, 없으면 placeholder 표시) ───
# AD_HEAD_SCRIPT=<script async src="https://pagead2.googlesyndication.com/..."></script>
# AD_SLOT_TOP=<ins class="adsbygoogle" ...></ins><script>...</script>
# AD_SLOT_INLINE=
# AD_SLOT_BOTTOM=
# AD_SLOT_SIDE1=
# AD_SLOT_SIDE2=

# AdSense ads.txt 한 줄 그대로 (예: google.com, pub-1234567890, DIRECT, f08c47fec0942fa0)
# ADS_TXT=google.com, pub-XXXXXXXXXX, DIRECT, f08c47fec0942fa0

# ─── SEO 인증 (네이버/구글 웹마스터 등록 시) ───
# NAVER_VERIFY=네이버서치어드바이저에서발급받은코드
# GOOGLE_VERIFY=구글서치콘솔에서발급받은코드

# ─── 분석 (선택, 하나만 또는 둘 다) ───
# GA_MEASUREMENT_ID=G-XXXXXXXXXX     # Google Analytics 4 측정 ID
# PLAUSIBLE_DOMAIN=grovel.kr         # Plausible Analytics 도메인
